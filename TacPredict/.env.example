# Public Supabase settings; configure locally and in production bindings.
# Keep the existing MAIN project (lmqaiqvwcytmgwgwyfwx). Do not create another.
VITE_SUPABASE_URL=https://lmqaiqvwcytmgwgwyfwx.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_project_publishable_key
SUPABASE_URL=https://lmqaiqvwcytmgwgwyfwx.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_project_publishable_key
# WalletConnect / Reown Cloud (RainbowKit + Wagmi) — wallets only, Base Mainnet
VITE_WALLETCONNECT_PROJECT_ID=ba72570e2db904ab92fdd696564a9cda
# Email/social must stay OFF — pure non-custodial wallet connect only.
VITE_EMAIL_OTP_ENABLED=false
VITE_GOOGLE_AUTH_ENABLED=false
VITE_X_AUTH_ENABLED=false
# SERVER ONLY. Never use a VITE_ prefix for these keys.
COINGECKO_DEMO_API_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Dedicated Base Mainnet RPC for wallet-link / order checks (Ankr or Alchemy). Never VITE_*.
BASE_PROTOCOL_RPC_URL=
# Optional Sepolia only; production is Base Mainnet chain 8453.
BASE_SEPOLIA_PROTOCOL_RPC_URL=
# Virtual paper-trading engine (feed-v1). Same Base HTTPS RPC is fine (Ankr). Never VITE_*.
VIRTUAL_RPC_URL=
# JSON: {chainId,engine,codeHash,startBlock,enabled,model:"feed-v1",markets,maxProjectionAgeSeconds}.
# Absent/enabled:false => no virtual trading. Never enable without an approved VirtualPriceAMM deploy.
# Assets: BTC, ETH, SOL, BNB only (no XRP). Feeds in src/lib/virtual/chainlink-feeds.ts.
VIRTUAL_TRADING_CONFIG=
# Optional Mainnet VirtualPriceAMM deploy (CREATE2). Never commit the key.
# VIRTUAL_ADMIN_ADDRESS=0x57828f1aa32fd6be3988f240068df53ed94b7aef
# VIRTUAL_MAINNET_DEPLOY_APPROVED=true
# VIRTUAL_DEPLOYER_PRIVATE_KEY=
# VIRTUAL_OPS_INDEX_APPROVED=true
# Contract addresses are NOT set via env. Authoritative Base Mainnet deployment:
# protocol/deployments/base-mainnet.json (verified=true, trading_enabled=false).
# Do not redeploy contracts or invent a second USDC token.
# Chainlink Base feeds (on-chain only) live in src/lib/virtual/chainlink-feeds.ts.
